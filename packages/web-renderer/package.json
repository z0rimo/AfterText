{
  "name": "@aftertext/web-renderer",
  "version": "0.1.1",
  "description": "AfterText Web Renderer Core: a minimal reusable React component that plays a compiled AfterText story via @aftertext/player.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z0rimo/AfterText.git",
    "directory": "packages/web-renderer"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -b --force",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@aftertext/compiler": "^0.1.1",
    "@aftertext/player": "^0.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.2"
  }
}
